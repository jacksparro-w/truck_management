generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Test {
  id Int @id @default(autoincrement())
}

model User {
  id           String   @id @default(uuid())
  name         String
  mobile       String   @unique
  password     String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshToken String?
  trips        Trip[]
  trucks       Truck[]
}

model Truck {
  id          String      @id @default(uuid())
  truckNumber String      @unique
  truckType   String
  status      TruckStatus @default(AVAILABLE)
  driverId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  trips       Trip[]
  driver      User?       @relation(fields: [driverId], references: [id])

  @@index([truckNumber])
}

model CargoType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Destination {
  id        String          @id @default(uuid())
  name      String
  type      DestinationType
  latitude  Decimal         @db.Decimal(10, 7)
  longitude Decimal         @db.Decimal(10, 7)
  radius    Int
  createdAt DateTime        @default(now())
  trips     Trip[]

  @@index([type])
}

model Trip {
  id            String        @id @default(uuid())
  truckId       String
  driverId      String
  cargoStatus   CargoStatus
  cargoTypeId   String?
  destinationId String
  status        TripStatus    @default(CREATED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  alerts        Alert[]
  gpsLocations  GPSLocation[]
  cargoType     CargoType?    @relation(fields: [cargoTypeId], references: [id])
  destination   Destination   @relation(fields: [destinationId], references: [id])
  driver        User          @relation(fields: [driverId], references: [id])
  truck         Truck         @relation(fields: [truckId], references: [id])

  @@index([truckId])
  @@index([driverId])
  @@index([status])
}

model GPSLocation {
  id        BigInt   @id @default(autoincrement())
  tripId    String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  speed     Float?
  heading   Float?
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@index([createdAt])
}

model Alert {
  id         String        @id @default(uuid())
  tripId     String
  type       AlertType
  severity   AlertSeverity
  title      String
  message    String
  isResolved Boolean       @default(false)
  createdAt  DateTime      @default(now())
  trip       Trip          @relation(fields: [tripId], references: [id])

  @@index([type])
  @@index([createdAt])
}

model CongestionEvent {
  id         String   @id @default(uuid())
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  radius     Int
  truckCount Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity])
}

enum UserRole {
  ADMIN
  DRIVER
  SUPERVISOR
}

enum TruckStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  OFFLINE
}

enum DestinationType {
  BERTH
  YARD
  TRANSIT
}

enum CargoStatus {
  LOADED
  EMPTY
}

enum TripStatus {
  CREATED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AlertType {
  WRONG_ROUTE
  CONGESTION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
